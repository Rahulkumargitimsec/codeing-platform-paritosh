# Everything here is optional for local development.
# With no .env at all the server starts an embedded MongoDB, runs code on
# your machine, and seeds 12 sample problems plus a demo admin account.

PORT=4000

# ── Database ────────────────────────────────────────────────
# Leave empty to use the embedded database (stored in backend/.data).
# Local MongoDB:  mongodb://127.0.0.1:27017/codejudge
# MongoDB Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/codejudge
DB_CONNECT_STRING=

# Any long random string (a dev default is used when empty; required in production)
JWT_KEY=

# Demo admin created on first start (when there is no admin yet)
# DEMO_ADMIN_EMAIL=admin@codejudge.dev
# DEMO_ADMIN_PASSWORD=Admin@1234

# Optional. Leave unset locally to use an in-memory logout blocklist.
# REDIS_URL=redis://localhost:6379

# ── Code execution ──────────────────────────────────────────
# Default: runs code locally with node / g++ / javac when no Judge0 is set.
# CODE_RUNNER=local            # force local runner
# CODE_RUNNER=judge0           # force Judge0
# RapidAPI key from https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_KEY=
# Or a self-hosted Judge0:
# JUDGE0_URL=http://localhost:2358
# JUDGE0_AUTH_TOKEN=

# ── AI tutor — set at least one ─────────────────────────────
GROQ_API_KEY=
GEMINI_KEY=
OPENROUTER_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=deepseek/deepseek-r1:free

# ── Video editorials (admin uploads) ────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Deployment only ─────────────────────────────────────────
# NODE_ENV=production        # makes the auth cookie Secure + SameSite=None
# CLIENT_URL=https://your-frontend.vercel.app
